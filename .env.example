APP_ENV=development
LOG_LEVEL=info
HTTP_ADDR=:8080

DATABASE_URL=postgres://localhost:5432/moepay?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Required (>= 32 bytes) in production. Generate with: openssl rand -base64 48
JWT_SECRET=
OTP_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

OTP_LENGTH=6
OTP_TTL=5m
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=30s
OTP_MAX_PER_PHONE_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=30
PHONE_DEFAULT_REGION=IN
# "log" prints OTPs to the server log; it is rejected when APP_ENV=production.
SMS_PROVIDER=log

# memory (single instance) or redis (shared across instances)
USERNAME_BLOOM_BACKEND=memory
USERNAME_BLOOM_EXPECTED_ITEMS=1000000
USERNAME_BLOOM_FP_RATE=0.01
USERNAME_BLOOM_REBUILD_INTERVAL=6h

# Comma-separated browser origins allowed to open WebSockets / call the API.
WS_ALLOWED_ORIGINS=
HTTP_CORS_ORIGINS=
HTTP_TRUSTED_PROXIES=
